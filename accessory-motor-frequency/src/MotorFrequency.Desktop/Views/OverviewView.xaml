<UserControl x:Class="MotorFrequency.Desktop.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="项目档案" Style="{StaticResource Heading}"/>
            <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Hint}"/>
            <Border Background="#EAF4F1" Padding="14" Margin="0,6,0,12">
                <TextBlock Text="工作流：建立项目 → 电机与候选 → 频带或频谱复核 → 参数研究与方案比较 → 保存重开与成果输出。每一步保留输入来源和计算边界。"/>
            </Border>
            <StackPanel IsEnabled="{Binding Editable}">
                <TextBlock Text="项目名称（必填，最多100字符）" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Metadata.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                <TextBlock Text="负责人（可选，不自动认证身份）" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Metadata.Owner, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                <TextBlock Text="项目目的与待复核问题（可选，最多2000字符）" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Metadata.Purpose, UpdateSourceTrigger=PropertyChanged}" Height="95" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2000"/>
                <Button Content="应用档案及当前条件" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,12,0,10" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <TextBlock Text="输入核对清单" Style="{StaticResource Subheading}"/>
            <TextBlock Text="下表提示补充证据的具体位置。已填写仅表示存在输入，不代表来源已经得到认证。" Style="{StaticResource Hint}"/>
            <ItemsControl ItemsSource="{Binding ReviewItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DFE6E9" BorderThickness="0,0,0,1" Padding="0,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"><Run Text="{Binding Subject}"/><Run Text="  ·  "/><Run Text="{Binding State}"/></TextBlock>
                                <TextBlock Text="{Binding Evidence}" Margin="0,5,0,3"/>
                                <TextBlock Text="{Binding NextAction}" Foreground="#5D727D"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
