<Window x:Class="MotorFrequency.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:MotorFrequency.Application;assembly=MotorFrequency.Application"
    xmlns:v="clr-namespace:MotorFrequency.Desktop.Views"
    Title="{Binding Title}" Width="1500" Height="950" MinWidth="1100" MinHeight="720"
    WindowStartupLocation="CenterScreen" Closing="WindowClosing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate x:Key="OverviewTemplate"><v:OverviewView/></DataTemplate>
        <DataTemplate x:Key="MotorTemplate"><v:MotorView/></DataTemplate>
        <DataTemplate x:Key="CandidateTemplate"><v:CandidateView/></DataTemplate>
        <DataTemplate x:Key="BandTemplate"><v:BandView/></DataTemplate>
        <DataTemplate x:Key="SpectrumTemplate"><v:SpectrumView/></DataTemplate>
        <DataTemplate x:Key="SweepTemplate"><v:SweepView/></DataTemplate>
        <DataTemplate x:Key="CompareTemplate"><v:CompareView/></DataTemplate>
        <DataTemplate x:Key="OutputTemplate"><v:OutputView/></DataTemplate>
        <DataTemplate x:Key="HistoryTemplate"><v:HistoryView/></DataTemplate>
        <DataTemplate x:Key="EmptyTemplate">
            <StackPanel MaxWidth="600" VerticalAlignment="Center" Margin="38">
                <TextBlock Text="建立可复核的频率设计项目" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,22,0,22"
                    Text="从结构与转速出发，保留候选依据，再与频谱和敏感频带核对。普通启动为空白；示例包含明确标识的模拟数据。"/>
                <WrapPanel>
                    <Button Content="新建空白项目" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="打开项目文件…" Command="{Binding OpenCommand}"/>
                    <Button Content="独立模拟示例" Command="{Binding DemoCommand}"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,28,0,0" Text="{Binding Boundary}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="5,3">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建空白项目" InputGestureText="Ctrl+N" Command="{Binding NewCommand}"/>
                <MenuItem Header="打开项目或备份…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                <Separator/>
                <MenuItem Header="保存" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="另存为…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                <MenuItem Header="复制为新项目" Command="{Binding DuplicateCommand}"/>
                <Separator/>
                <MenuItem Header="载入独立模拟示例" Command="{Binding DemoCommand}"/>
                <MenuItem Header="归档 / 取消归档" Command="{Binding ArchiveCommand}"/>
                <Separator/>
                <MenuItem Header="退出" Click="ExitClick"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="应用条件" Command="{Binding ApplyCommand}"/>
                <MenuItem Header="重置草稿" Command="{Binding ResetCommand}"/>
                <Separator/>
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="重做" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="计算边界与使用说明" Click="HelpClick"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" BorderBrush="#BCCCD1" BorderThickness="0,1,0,0" Background="White" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Message}" MaxHeight="64" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="#27534C"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#A12D22"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StateLabel}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222" MinWidth="190" MaxWidth="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="450"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="258" MinWidth="200" MaxWidth="420"/>
            </Grid.ColumnDefinitions>
            <Border Background="#1E3540" Padding="18,24,14,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="MOTOR / FREQUENCY" Foreground="#8CD7C7" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="附件电机&#10;频率设计工作台" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,14"/>
                        <TextBlock Text="{Binding SourceLabel}" Foreground="#B9D7D7" Margin="0,0,0,20"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock Text="{Binding Current.Name, TargetNullValue=尚无项目}" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FilePath}" Foreground="#B5C9D1" FontSize="11" Margin="0,6,0,12" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                        <Button Content="保存项目" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{x:Static vm:WorkspaceViewModel.Navigation}" SelectedValuePath="Key"
                        SelectedValue="{Binding Section}" Background="Transparent" BorderThickness="0"
                        Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,5,0,0" Opacity="0.8"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D7E0E4"/>
            <Border Grid.Column="2" Margin="14" Background="White" BorderBrush="#D5E0E3" BorderThickness="1" Padding="18">
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource OverviewTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Section}" Value="motor"><Setter Property="ContentTemplate" Value="{StaticResource MotorTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Section}" Value="candidates"><Setter Property="ContentTemplate" Value="{StaticResource CandidateTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Section}" Value="bands"><Setter Property="ContentTemplate" Value="{StaticResource BandTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Section}" Value="spectrum"><Setter Property="ContentTemplate" Value="{StaticResource SpectrumTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Section}" Value="sweep"><Setter Property="ContentTemplate" Value="{StaticResource SweepTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Section}" Value="compare"><Setter Property="ContentTemplate" Value="{StaticResource CompareTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Section}" Value="output"><Setter Property="ContentTemplate" Value="{StaticResource OutputTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Section}" Value="history"><Setter Property="ContentTemplate" Value="{StaticResource HistoryTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="ContentTemplate" Value="{StaticResource EmptyTemplate}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#D7E0E4"/>
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,22,16,16">
                <StackPanel>
                    <TextBlock Text="条件检查器" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TopologySummary}" Style="{StaticResource Hint}"/>
                    <TextBlock Text="已应用观察条件" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding InspectSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,18"/>
                    <TextBlock Text="输入采用草稿，应用条件后重新计算；保存会校验并应用条件草稿。新增表单须先完成添加或重置。" Style="{StaticResource Hint}"/>
                    <Button Content="应用条件" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="重置草稿" Command="{Binding ResetCommand}"/>
                    <Separator Margin="0,20"/>
                    <TextBlock Text="所选候选依据" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedBasis}" Style="{StaticResource Hint}"/>
                    <TextBlock Text="计算与证据边界" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <ItemsControl ItemsSource="{Binding QualityNotes}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Hint}"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="本机离线运行 · C# WPF / MVVM" FontSize="10" Foreground="#607780" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
