<Window x:Class="Cabin.Desktop.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Cabin.Desktop.Controls"
 Title="{Binding Title}" Width="1440" Height="920" MinWidth="1160" MinHeight="720"
 WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Window.InputBindings>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
  <KeyBinding Key="F5" Command="{Binding CalculateCommand}"/>
 </Window.InputBindings>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Menu Background="#E7EBE8" Padding="8,4">
   <MenuItem Header="文件(_F)">
    <MenuItem Header="新建空白项目" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/>
    <MenuItem Header="打开项目…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
    <MenuItem Header="载入独立模拟示例…" Command="{Binding ExampleCommand}"/>
    <Separator/>
    <MenuItem Header="保存项目" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
    <MenuItem Header="另存为…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
    <MenuItem Header="复制为新项目" Command="{Binding DuplicateCommand}"/>
    <Separator/>
    <MenuItem Header="退出" Click="Exit"/>
   </MenuItem>
   <MenuItem Header="点位(_P)">
    <MenuItem Header="导入CSV并预检…" Command="{Binding ImportCommand}"/>
    <MenuItem Header="导出点位CSV…" Command="{Binding ExportPointsCommand}"/>
   </MenuItem>
   <MenuItem Header="计算(_C)">
    <MenuItem Header="校验输入" Command="{Binding ValidateCommand}"/>
    <MenuItem Header="计算相对声场" Command="{Binding CalculateCommand}" InputGestureText="F5"/>
    <MenuItem Header="取消计算" Command="{Binding CancelCommand}"/>
   </MenuItem>
   <MenuItem Header="导出(_E)">
    <MenuItem Header="离线研究报告 TXT…" Command="{Binding ExportReportCommand}"/>
    <MenuItem Header="座位复数频响 CSV…" Command="{Binding ExportResponsesCommand}"/>
    <MenuItem Header="模态清单 CSV…" Command="{Binding ExportModesCommand}"/>
    <MenuItem Header="当前剖面 CSV…" Command="{Binding ExportFieldCommand}"/>
    <MenuItem Header="当前声场画布 PNG…" Command="{Binding ExportImageCommand}"/>
    <MenuItem Header="参数扫描 CSV…" Command="{Binding ExportScanCommand}"/>
    <MenuItem Header="基准差异 CSV…" Command="{Binding ExportComparisonCommand}"/>
   </MenuItem>
  </Menu>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="205" MinWidth="180"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*" MinWidth="530"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="280" MinWidth="230"/>
   </Grid.ColumnDefinitions>
   <Border Background="#193747">
    <DockPanel Margin="15,22,12,14">
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <TextBlock Text="CABIN / MODES" Foreground="#7DC7CE" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="座舱模态工作台" Foreground="White" FontSize="22" Margin="0,8,0,4"/>
      <TextBlock Text="Windows 原生桌面 · V1.0" Foreground="#AEC3CC" FontSize="11"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock Text="相对响应研究" Foreground="#E8C6A6" FontWeight="SemiBold"/>
      <TextBlock Text="理想刚性矩形腔，不等于实车绝对声压。" Foreground="#C5D5DA" FontSize="11" Margin="0,6,0,0"/>
     </StackPanel>
     <TreeView x:Name="Navigation" SelectedItemChanged="Navigate" Background="Transparent" BorderThickness="0" Foreground="White">
      <TreeView.Resources>
       <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="#E5EFF2"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="Padding" Value="4,5"/>
        <Setter Property="IsExpanded" Value="True"/>
       </Style>
      </TreeView.Resources>
      <TreeViewItem Header="工程输入">
       <TreeViewItem Header="项目档案" Tag="project" IsSelected="True"/>
       <TreeViewItem Header="声源与耳点" Tag="points"/>
      </TreeViewItem>
      <TreeViewItem Header="声学研究">
       <TreeViewItem Header="空间剖面" Tag="field"/>
       <TreeViewItem Header="座位频响" Tag="spectrum"/>
       <TreeViewItem Header="模态谱系" Tag="modes"/>
       <TreeViewItem Header="耦合与贡献" Tag="contributions"/>
      </TreeViewItem>
      <TreeViewItem Header="方案复核">
       <TreeViewItem Header="基准比较" Tag="comparison"/>
       <TreeViewItem Header="参数扫描" Tag="scan"/>
       <TreeViewItem Header="数值敏感性" Tag="diagnostics"/>
       <TreeViewItem Header="工程复核与历史" Tag="reviews"/>
      </TreeViewItem>
      <TreeViewItem Header="使用帮助" Tag="help"/>
     </TreeView>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CEDADB"/>
   <DockPanel Grid.Column="2" Margin="22,18,22,12">
    <Border DockPanel.Dock="Top" Background="#E4EEEA" Padding="12,9" Margin="0,0,0,14" CornerRadius="4">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ResultStatus}" FontSize="12"/>
      <TextBlock Grid.Column="1" Text="{Binding Editor.SourceBadge}" Foreground="#856029" FontSize="11" Margin="8,0,0,0"/>
     </Grid>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel IsEnabled="{Binding NotBusy}">
      <Border Style="{StaticResource Card}" Visibility="{Binding HasProject, Converter={StaticResource BoolVisibility}, ConverterParameter=invert}">
       <StackPanel>
        <TextBlock Text="建立你的第一个座舱研究" Style="{StaticResource Heading}"/>
        <TextBlock Text="普通启动没有项目或计算结果。可建立空白项目，手工填写理想模型；也可显式载入独立模拟示例，核对软件流程。" Style="{StaticResource Hint}"/>
        <WrapPanel>
         <Button Content="新建空白项目" Command="{Binding NewCommand}" Style="{StaticResource Primary}"/>
         <Button Content="打开项目…" Command="{Binding OpenCommand}"/>
         <Button Content="独立模拟示例…" Command="{Binding ExampleCommand}"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=project}">
       <TextBlock Text="项目档案" Style="{StaticResource Heading}"/>
       <TextBlock Text="记录来源与研究条件。右侧属性面板设置矩形腔与分析频带，左侧工程树进入声源与耳点。" Style="{StaticResource Hint}"/>
       <Border Style="{StaticResource Card}" Visibility="{Binding HasProject, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
         <ItemsControl ItemsSource="{Binding Editor.Metadata}" ItemTemplate="{StaticResource FieldTemplate}"/>
         <TextBlock Text="项目位置" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding FileLocation}" Style="{StaticResource Hint}"/>
         <TextBlock Text="{Binding Scope}" Foreground="#956034" Margin="0,8"/>
         <WrapPanel Margin="0,12,0,0">
          <Button Content="校验输入" Command="{Binding ValidateCommand}"/>
          <Button Content="计算相对声场" Command="{Binding CalculateCommand}" Style="{StaticResource Primary}"/>
          <Button Content="保存项目" Command="{Binding SaveCommand}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=points}">
       <TextBlock Text="声源与座位耳点" Style="{StaticResource Heading}"/>
       <TextBlock Text="坐标以米计，原点为前左下角。双击表格编辑；红框表示格式或范围错误，跨字段越界由“校验输入”定位。最多8个声源、12个耳点。" Style="{StaticResource Hint}"/>
       <TextBlock Text="相干点声源" Style="{StaticResource Subheading}"/>
       <WrapPanel>
        <Button Content="添加声源" Command="{Binding AddSourceCommand}"/>
        <Button Content="删除所选声源" Command="{Binding DeleteSourceCommand}"/>
        <Button Content="导入CSV预检…" Command="{Binding ImportCommand}"/>
       </WrapPanel>
       <DataGrid ItemsSource="{Binding Editor.Sources}" SelectedItem="{Binding SelectedSource}" Height="230" IsEnabled="{Binding CanEdit}">
        <DataGrid.Columns>
         <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
         <DataGridTextColumn Header="名称" Binding="{Binding Name.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="150"/>
         <DataGridTextColumn Header="x / m" Binding="{Binding X.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="75"/>
         <DataGridTextColumn Header="y / m" Binding="{Binding Y.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="75"/>
         <DataGridTextColumn Header="z / m" Binding="{Binding Z.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="75"/>
         <DataGridTextColumn Header="幅值" Binding="{Binding Amplitude.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="75"/>
         <DataGridTextColumn Header="相位 / °" Binding="{Binding Phase.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="85"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="声源幅值为无量纲，0—10；相位−180°至180°，所有声源共用相位参考。停用的声源仍须保持合法坐标。" Style="{StaticResource Hint}"/>
       <TextBlock Text="座位耳点" Style="{StaticResource Subheading}"/>
       <WrapPanel>
        <Button Content="添加耳点" Command="{Binding AddSeatCommand}"/>
        <Button Content="删除所选耳点" Command="{Binding DeleteSeatCommand}"/>
        <Button Content="导出点位CSV…" Command="{Binding ExportPointsCommand}"/>
       </WrapPanel>
       <DataGrid ItemsSource="{Binding Editor.Seats}" SelectedItem="{Binding SelectedSeat}" Height="255" IsEnabled="{Binding CanEdit}">
        <DataGrid.Columns>
         <DataGridTextColumn Header="座位名称" Binding="{Binding Name.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="135"/>
         <DataGridTextColumn Header="x / m" Binding="{Binding X.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="75"/>
         <DataGridTextColumn Header="y / m" Binding="{Binding Y.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="75"/>
         <DataGridTextColumn Header="z / m" Binding="{Binding Z.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="75"/>
         <DataGridTextColumn Header="备注" Binding="{Binding Note.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="200"/>
        </DataGrid.Columns>
       </DataGrid>
       <Button Content="校验输入后计算" Command="{Binding CalculateCommand}" HorizontalAlignment="Left" Style="{StaticResource Primary}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=field}">
       <TextBlock Text="空间声场剖面" Style="{StaticResource Heading}"/>
       <TextBlock Text="选择显示量与剖面，再更新画布。振型与响应幅值含义不同；改变选择后旧画布立即清空。" Style="{StaticResource Hint}"/>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
           <TextBlock Text="剖面方向"/>
           <ComboBox ItemsSource="{Binding Planes}" SelectedItem="{Binding Plane}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
           <TextBlock Text="显示量"/>
           <CheckBox Content="显示所选模态的有符号振型" IsChecked="{Binding ShowShape}" Margin="0,10,0,12"/>
          </StackPanel>
         </Grid>
         <TextBlock Text="固定轴剖面位置（0—1）"/>
         <Slider Minimum="0" Maximum="1" Value="{Binding Slice}" TickFrequency="0.1" TickPlacement="BottomRight" Margin="0,8"/>
         <TextBlock Text="所选模态"/>
         <ComboBox ItemsSource="{Binding Result.Modes}" SelectedItem="{Binding SelectedMode}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Key, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Frequency, StringFormat=F3, Mode=OneWay}"/><Run Text=" Hz"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox>
         <TextBlock Text="研究频率 / Hz（响应幅值使用此频率）"/>
         <Slider Minimum="5" Maximum="500" Value="{Binding Frequency}" Margin="0,7"/>
         <TextBlock Text="{Binding SelectionHint}" FontWeight="SemiBold" Margin="0,4,0,10"/>
         <WrapPanel>
          <Button Content="更新剖面与贡献" Command="{Binding UpdateFieldCommand}" Style="{StaticResource Primary}"/>
          <Button Content="导出剖面CSV…" Command="{Binding ExportFieldCommand}"/>
          <Button Content="导出画布PNG…" Command="{Binding ExportImageCommand}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border BorderBrush="#CDDCDD" BorderThickness="1" Margin="0,0,0,12">
        <controls:FieldCanvas x:Name="FieldDrawing" Field="{Binding Field}" Project="{Binding ComputedProject}" Height="420"/>
       </Border>
       <TextBlock Text="{Binding FieldHint}" Style="{StaticResource Hint}"/>
       <TextBlock Text="图形保持实际长宽比例。声源和耳点标记为向该剖面的投影，不代表均位于该切面。鼠标移至图内可查看网格坐标和相对量。" Style="{StaticResource Hint}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=spectrum}">
       <TextBlock Text="座位频响比较" Style="{StaticResource Heading}"/>
       <TextBlock Text="所有座位使用同一全频带最大响应作为0dB参考。图中dB为相对幅值，非dB SPL。曲线点击横坐标选择频率，再到空间剖面更新。" Style="{StaticResource Hint}"/>
       <controls:SpectrumChart Data="{Binding Spectrum}" SelectedX="{Binding Frequency}" Height="450"/>
       <DataGrid ItemsSource="{Binding Result.Curves}" SelectedItem="{Binding SelectedCurve}" Height="260" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="座位" Binding="{Binding Name, Mode=OneWay}" Width="140"/>
         <DataGridTextColumn Header="采样峰值 / 相对量" Binding="{Binding Peak.Magnitude, StringFormat=G5, Mode=OneWay}" Width="155"/>
         <DataGridTextColumn Header="峰值频率 / Hz" Binding="{Binding Peak.Frequency, StringFormat=F3, Mode=OneWay}" Width="125"/>
         <DataGridTextColumn Header="采样RMS / 相对量" Binding="{Binding Rms, StringFormat=G5, Mode=OneWay}" Width="160"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="RMS为离散频率样点幅值的均方根，不是时间域声压有效值。峰值可能受采样步长影响；近零响应的dB显示下限为−120。" Style="{StaticResource Hint}"/>
       <Button Content="导出复数频响CSV…" Command="{Binding ExportResponsesCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=modes}">
       <TextBlock Text="非零阶模态谱系" Style="{StaticResource Heading}"/>
       <TextBlock Text="轴向仅一个阶次非零，切向两个，斜向三个。000均匀压缩模态不计入。相同频率的退化模态保留各基底。选择一行后可到空间剖面显示振型。" Style="{StaticResource Hint}"/>
       <DataGrid ItemsSource="{Binding Result.Modes}" SelectedItem="{Binding SelectedMode}" Height="420" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="阶次 nx,ny,nz" Binding="{Binding Key, Mode=OneWay}" Width="130"/>
         <DataGridTextColumn Header="固有频率 / Hz" Binding="{Binding Frequency, StringFormat=F4, Mode=OneWay}" Width="140"/>
         <DataGridTextColumn Header="类型" Binding="{Binding Kind, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="退化数" Binding="{Binding Degeneracy, Mode=OneWay}" Width="85"/>
         <DataGridTextColumn Header="归一化系数 2^d" Binding="{Binding NormFactor, Mode=OneWay}" Width="135"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="每25Hz频带的模态数量" Style="{StaticResource Subheading}"/>
       <DataGrid ItemsSource="{Binding Density}" Height="240" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="下限 / Hz（含）" Binding="{Binding Lower, Mode=OneWay}" Width="130"/>
         <DataGridTextColumn Header="上限 / Hz（不含）" Binding="{Binding Upper, Mode=OneWay}" Width="145"/>
         <DataGridTextColumn Header="总数" Binding="{Binding Count, Mode=OneWay}" Width="70"/>
         <DataGridTextColumn Header="轴向" Binding="{Binding Axial, Mode=OneWay}" Width="70"/>
         <DataGridTextColumn Header="切向" Binding="{Binding Tangential, Mode=OneWay}" Width="70"/>
         <DataGridTextColumn Header="斜向" Binding="{Binding Oblique, Mode=OneWay}" Width="70"/>
        </DataGrid.Columns>
       </DataGrid>
       <Button Content="导出模态清单CSV…" Command="{Binding ExportModesCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=contributions}">
       <TextBlock Text="声源耦合与模态贡献" Style="{StaticResource Heading}"/>
       <TextBlock Text="选择耳点，在空间剖面设置研究频率后更新。贡献按单个模态复数项的幅值降序列出；各项幅值不能直接相加得到总响应。" Style="{StaticResource Hint}"/>
       <ComboBox ItemsSource="{Binding Result.Curves}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCurve}"/>
       <TextBlock Text="{Binding SelectionHint}" Style="{StaticResource Hint}"/>
       <Button Content="更新剖面与贡献" Command="{Binding UpdateFieldCommand}" HorizontalAlignment="Left"/>
       <DataGrid ItemsSource="{Binding Contributions}" Height="325" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="阶次" Binding="{Binding Key, Mode=OneWay}" Width="85"/>
         <DataGridTextColumn Header="fn / Hz" Binding="{Binding Frequency, StringFormat=F3, Mode=OneWay}" Width="95"/>
         <DataGridTextColumn Header="项幅值" Binding="{Binding Magnitude, StringFormat=G5, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="项相位 / °" Binding="{Binding Phase, StringFormat=F2, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="源耦合幅值" Binding="{Binding SourceMagnitude, StringFormat=G4, Mode=OneWay}" Width="110"/>
         <DataGridTextColumn Header="耳点振型" Binding="{Binding SeatShape, StringFormat=F4, Mode=OneWay}" Width="100"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="分析频带内耦合观察" Style="{StaticResource Subheading}"/>
       <DataGrid ItemsSource="{Binding Coupling}" Height="280" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="阶次" Binding="{Binding ModeKey, Mode=OneWay}" Width="85"/>
         <DataGridTextColumn Header="fn / Hz" Binding="{Binding Frequency, StringFormat=F3, Mode=OneWay}" Width="90"/>
         <DataGridTextColumn Header="源幅值" Binding="{Binding SourceMagnitude, StringFormat=G4, Mode=OneWay}" Width="90"/>
         <DataGridTextColumn Header="耳点振型" Binding="{Binding SeatShape, StringFormat=F4, Mode=OneWay}" Width="95"/>
         <DataGridTextColumn Header="数值观察" Binding="{Binding Observation, Mode=OneWay}" Width="230"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="弱耦合阈值：源耦合低于启用幅值和的1%，或耳点振型绝对值低于0.01。仅为数值观察，不是工程合格标准。" Style="{StaticResource Hint}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=comparison}">
       <TextBlock Text="方案基准比较" Style="{StaticResource Heading}"/>
       <TextBlock Text="捕获的是当前计算输入，项目保存时一并内嵌。比较按耳点标识匹配；更换CSV导入点位会建立新标识。" Style="{StaticResource Hint}"/>
       <TextBlock Text="新基准名称"/>
       <TextBox Text="{Binding BaselineName, UpdateSourceTrigger=PropertyChanged}"/>
       <Button Content="捕获当前计算输入" Command="{Binding CaptureBaselineCommand}" HorizontalAlignment="Left"/>
       <ComboBox ItemsSource="{Binding Baselines}" SelectedItem="{Binding SelectedBaseline}" DisplayMemberPath="Name"/>
       <WrapPanel>
        <Button Content="复算并比较基准" Command="{Binding CompareCommand}" Style="{StaticResource Primary}"/>
        <Button Content="恢复基准输入…" Command="{Binding RestoreBaselineCommand}"/>
        <Button Content="删除基准…" Command="{Binding DeleteBaselineCommand}"/>
       </WrapPanel>
       <TextBlock Text="频带、步长、截断、数据来源和模拟标记必须一致。尺寸、阻尼、声速或耳点变化会显著提示，不能把混合差异归因于单一因素。" Style="{StaticResource Hint}"/>
       <ItemsControl ItemsSource="{Binding Comparison.Warnings}">
        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#A2642D" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <DataGrid ItemsSource="{Binding Comparison.Seats}" Height="270" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="耳点" Binding="{Binding Name, Mode=OneWay}" Width="110"/>
         <DataGridTextColumn Header="基准峰值" Binding="{Binding BaselinePeak, StringFormat=G5, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="当前峰值" Binding="{Binding CurrentPeak, StringFormat=G5, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="峰值比 / dB" Binding="{Binding PeakRatioDb, StringFormat=F3, Mode=OneWay}" Width="105"/>
         <DataGridTextColumn Header="RMS比 / dB" Binding="{Binding RmsRatioDb, StringFormat=F3, Mode=OneWay}" Width="105"/>
         <DataGridTextColumn Header="当前峰频 / Hz" Binding="{Binding CurrentFrequency, StringFormat=F3, Mode=OneWay}" Width="120"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="同阶次固有频率变化" Style="{StaticResource Subheading}"/>
       <DataGrid ItemsSource="{Binding Comparison.Modes}" Height="225" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="阶次" Binding="{Binding Key, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="基准 / Hz" Binding="{Binding BaselineFrequency, StringFormat=F3, Mode=OneWay}" Width="120"/>
         <DataGridTextColumn Header="当前 / Hz" Binding="{Binding CurrentFrequency, StringFormat=F3, Mode=OneWay}" Width="120"/>
         <DataGridTextColumn Header="变化 / %" Binding="{Binding Percent, StringFormat=F3, Mode=OneWay}" Width="110"/>
        </DataGrid.Columns>
       </DataGrid>
       <Button Content="导出基准差异CSV…" Command="{Binding ExportComparisonCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=scan}">
       <TextBlock Text="参数扫描" Style="{StaticResource Heading}"/>
       <TextBlock Text="在当前计算输入上独立计算2—21个候选，记录选定耳点的采样峰值与RMS。几何扫描保持绝对坐标；越界候选逐行报错。最低值不是实车最优保证。" Style="{StaticResource Hint}"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0">
         <TextBlock Text="扫描参数"/>
         <ComboBox ItemsSource="{Binding ScanParameters}" SelectedItem="{Binding ScanParameter}"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
         <TextBlock Text="目标耳点"/>
         <ComboBox ItemsSource="{Binding Editor.Seats}" DisplayMemberPath="Name.Text" SelectedItem="{Binding SelectedSeat}"/>
        </StackPanel>
       </Grid>
       <UniformGrid Columns="3">
        <ContentControl Content="{Binding ScanStart}" ContentTemplate="{StaticResource FieldTemplate}" Margin="0,0,10,0"/>
        <ContentControl Content="{Binding ScanEnd}" ContentTemplate="{StaticResource FieldTemplate}" Margin="0,0,10,0"/>
        <ContentControl Content="{Binding ScanCount}" ContentTemplate="{StaticResource FieldTemplate}"/>
       </UniformGrid>
       <WrapPanel>
        <Button Content="运行参数扫描" Command="{Binding ScanCommand}" Style="{StaticResource Primary}"/>
        <Button Content="应用所选候选…" Command="{Binding ApplyScanCommand}"/>
        <Button Content="导出扫描CSV…" Command="{Binding ExportScanCommand}"/>
       </WrapPanel>
       <controls:SpectrumChart Data="{Binding ScanPlot}" Height="310"/>
       <DataGrid ItemsSource="{Binding Scan.Rows}" SelectedItem="{Binding SelectedScanRow}" Height="290" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="参数值" Binding="{Binding Parameter, StringFormat=G5, Mode=OneWay}" Width="90"/>
         <DataGridTextColumn Header="采样峰值" Binding="{Binding PeakMagnitude, StringFormat=G5, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="峰频 / Hz" Binding="{Binding PeakFrequency, StringFormat=F3, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="采样RMS" Binding="{Binding Rms, StringFormat=G5, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="首模态 / Hz" Binding="{Binding FirstMode, StringFormat=F3, Mode=OneWay}" Width="105"/>
         <DataGridTextColumn Header="无效候选原因" Binding="{Binding Error, Mode=OneWay}" Width="320"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="失败行的数值占位0无物理意义，以错误原因列为准；导出中失败指标为空。首个声源坐标扫描按点位表顺序，不按选中行。" Style="{StaticResource Hint}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=diagnostics}">
       <TextBlock Text="数值敏感性与提示" Style="{StaticResource Heading}"/>
       <TextBlock Text="这些检查帮助识别采样、截断、退化与零响应问题，不校准实车模型。没有提示也不表示模型已验证。" Style="{StaticResource Hint}"/>
       <Border Style="{StaticResource Card}">
        <ItemsControl ItemsSource="{Binding Advice}">
         <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </Border>
       <TextBlock Text="增加截断100Hz的对照计算" Style="{StaticResource Subheading}"/>
       <TextBlock Text="保持几何、源、耳点及频带不变，只增加截断频率，最高1000Hz。结果仅反映两次截断选择的差异，不证明收敛。" Style="{StaticResource Hint}"/>
       <Button Content="计算截断敏感性" Command="{Binding TruncationCommand}" HorizontalAlignment="Left"/>
       <TextBlock Margin="0,8">
        <Run Text="原截断 / Hz："/><Run Text="{Binding Truncation.OriginalCutoff, Mode=OneWay}"/>
        <Run Text="    扩展截断 / Hz："/><Run Text="{Binding Truncation.ExtendedCutoff, Mode=OneWay}"/>
       </TextBlock>
       <DataGrid ItemsSource="{Binding Truncation.Rows}" Height="330" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="座位" Binding="{Binding Seat, Mode=OneWay}" Width="120"/>
         <DataGridTextColumn Header="原RMS" Binding="{Binding OriginalRms, StringFormat=G5, Mode=OneWay}" Width="110"/>
         <DataGridTextColumn Header="扩展RMS" Binding="{Binding ExtendedRms, StringFormat=G5, Mode=OneWay}" Width="110"/>
         <DataGridTextColumn Header="比值 / dB" Binding="{Binding RatioDb, StringFormat=F4, Mode=OneWay}" Width="110"/>
         <DataGridTextColumn Header="原峰值" Binding="{Binding OriginalPeak, StringFormat=G5, Mode=OneWay}" Width="100"/>
         <DataGridTextColumn Header="扩展峰值" Binding="{Binding ExtendedPeak, StringFormat=G5, Mode=OneWay}" Width="110"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="近零原始RMS时比值不可稳定计算（NaN），不能解释为实际增益。完整研究报告同时包含本次敏感性结果。" Style="{StaticResource Hint}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=reviews}">
       <TextBlock Text="工程复核与历史" Style="{StaticResource Heading}"/>
       <TextBlock Text="记录下一步实测或高保真仿真任务。复核状态由工程师填写，软件不会把理想模型计算自动标记为实测通过。" Style="{StaticResource Hint}"/>
       <WrapPanel>
        <Button Content="添加复核项" Command="{Binding AddReviewCommand}"/>
        <Button Content="删除所选复核项…" Command="{Binding DeleteReviewCommand}"/>
       </WrapPanel>
       <DataGrid ItemsSource="{Binding Reviews}" SelectedItem="{Binding SelectedReview}" Height="330" IsEnabled="{Binding CanEdit}" RowHeight="60">
        <DataGrid.Columns>
         <DataGridTextColumn Header="复核对象" Binding="{Binding Target.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="150"/>
         <DataGridTextColumn Header="复核步骤" Binding="{Binding Action.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="300"/>
         <DataGridTextColumn Header="负责人" Binding="{Binding Owner.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="100"/>
         <DataGridTextColumn Header="结果 / 状态" Binding="{Binding Result.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="160"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="保存历史（随项目内嵌，最多500条）" Style="{StaticResource Subheading}"/>
       <DataGrid ItemsSource="{Binding Journal}" Height="250" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="UTC时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss, Mode=OneWay}" Width="170"/>
         <DataGridTextColumn Header="操作" Binding="{Binding Action, Mode=OneWay}" Width="140"/>
         <DataGridTextColumn Header="详情" Binding="{Binding Detail, Mode=OneWay}" Width="350"/>
        </DataGrid.Columns>
       </DataGrid>
       <WrapPanel>
        <Button Content="保存项目" Command="{Binding SaveCommand}"/>
        <Button Content="导出离线研究报告…" Command="{Binding ExportReportCommand}"/>
       </WrapPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=help}">
       <TextBlock Text="使用帮助与计算口径" Style="{StaticResource Heading}"/>
       <TextBlock Text="先建立研究，再解释相对量" Style="{StaticResource Subheading}"/>
       <TextBlock Text="1. 在文件菜单新建空白项目，记录名称、修订和输入来源。右侧填写矩形腔尺寸、声速、阻尼、频带和截断。普通启动不会自动加载示例。" Style="{StaticResource Hint}"/>
       <TextBlock Text="2. 进入“声源与耳点”，添加至少一个启用且非零幅值声源和一个耳点。坐标包含壁面边界0与轴长。坐标越界请修改该行或相应几何。" Style="{StaticResource Hint}"/>
       <TextBlock Text="3. 校验输入，点击右下“计算相对声场”或按F5。计算期间可在状态栏取消；结果完成后进入空间剖面。" Style="{StaticResource Hint}"/>
       <TextBlock Text="4. 选择剖面、固定轴比例、研究频率与显示量，点击“更新剖面与贡献”。振型取余弦基底，有符号；响应为多源相干复数叠加的幅值。" Style="{StaticResource Hint}"/>
       <TextBlock Text="5. 用座位频响、模态谱系和耦合表核对原因。捕获基准后调整输入并重算；在基准比较读取提示。参数扫描会保持点位的绝对米制坐标。" Style="{StaticResource Hint}"/>
       <TextBlock Text="6. 使用Ctrl+S保存可搬迁项目，再从文件菜单打开重算。项目内嵌所有输入、基准与复核；CSV及文本研究报告是成果输出，不能替代项目保存。" Style="{StaticResource Hint}"/>
       <TextBlock Text="数学模型" Style="{StaticResource Subheading}"/>
       <TextBlock Text="fn = c/2 · sqrt[(nx/Lx)² + (ny/Ly)² + (nz/Lz)²]。nx、ny、nz为非负整数，排除000。振型为三个方向余弦的乘积。响应为模态项复数和，各项含2^d体积归一化、源耦合、耳点振型和阻尼分母。固定100Hz、1m³参考标度，结果为无量纲研究指标。" Style="{StaticResource Hint}"/>
       <TextBlock Text="重要边界" Style="{StaticResource Subheading}"/>
       <TextBlock Text="只处理理想矩形刚性封闭腔。不含真实内饰、柔性板、复杂几何、泄漏和实测标定。没有000均匀压缩模态。所有显示与导出均不能解释为Pa或dB SPL，也不能证明实车降噪效果。" Style="{StaticResource Hint}"/>
       <TextBlock Text="数据文件与错误恢复" Style="{StaticResource Subheading}"/>
       <TextBlock Text="项目扩展名.cabin.json，格式版本1，最大2MiB。损坏、缺字段、未知字段及不支持版本被拒绝；失败不会替换当前项目。点位CSV使用UTF-8、逗号、小数点，表头见导出文件；不支持单元格换行。基准最多12项，复核最多100项。" Style="{StaticResource Hint}"/>
       <TextBlock Text="输入改动后结果清空是正常行为。若图像为空，请先计算，再更新剖面。若扫描候选失败，阅读该行错误；几何减小时尤其注意耳点越界。近零基准不计算稳定比值。" Style="{StaticResource Hint}"/>
       <TextBlock Text="运行与交付" Style="{StaticResource Subheading}"/>
       <TextBlock Text="正式运行需要Windows 10/11。自包含发布包可离线双击CabinAcoustics.exe。源码入口为CabinAcoustics.sln；详细构建命令、验证记录和待验证项目见项目docs。" Style="{StaticResource Hint}"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#CEDADB"/>
   <Border Grid.Column="4" Background="#EDF0ED" Padding="16,18,14,12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="模型属性" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="修改后旧结果立即失效" Style="{StaticResource Hint}" FontSize="11"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button Content="校验输入" Command="{Binding ValidateCommand}" Margin="0,0,0,8"/>
      <Button Content="计算相对声场  F5" Command="{Binding CalculateCommand}" Style="{StaticResource Primary}" Margin="0"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}">
      <StackPanel>
       <TextBlock Text="理想矩形腔" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <ItemsControl ItemsSource="{Binding Editor.Geometry}" ItemTemplate="{StaticResource FieldTemplate}"/>
       <TextBlock Text="分析与截断" FontWeight="SemiBold" Margin="0,12,0,10"/>
       <ItemsControl ItemsSource="{Binding Editor.Analysis}" ItemTemplate="{StaticResource FieldTemplate}"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#DFE7E5" Padding="12,7">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,0,12,0"/>
    <ProgressBar Grid.Column="1" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="9" Margin="0,0,12,0"
      Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
    <Button Grid.Column="2" Content="取消计算" Command="{Binding CancelCommand}" Margin="0" Padding="10,3"/>
   </Grid>
  </Border>
 </Grid>
</Window>
