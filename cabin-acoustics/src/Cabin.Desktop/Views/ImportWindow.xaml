<Window x:Class="Cabin.Desktop.Views.ImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="点位CSV预检" Width="850" Height="600" MinWidth="700" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="140"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="先核对，再替换点位" Style="{StaticResource Heading}"/>
   <TextBlock Text="仅接受UTF-8、小数点数值、米制坐标。任一行错误均阻止应用；确认后替换全部声源和耳点。导入的声源均为启用，请核对启停。" Style="{StaticResource Hint}"/>
  </StackPanel>
  <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80"/>
    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
    <DataGridTextColumn Header="x / m" Binding="{Binding Point.X}" Width="80"/>
    <DataGridTextColumn Header="y / m" Binding="{Binding Point.Y}" Width="80"/>
    <DataGridTextColumn Header="z / m" Binding="{Binding Point.Z}" Width="80"/>
    <DataGridTextColumn Header="幅值" Binding="{Binding Amplitude}" Width="70"/>
    <DataGridTextColumn Header="相位 / °" Binding="{Binding Phase}" Width="85"/>
    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
  <GroupBox Grid.Row="2" Header="预检问题（无问题时可应用）">
   <ListBox ItemsSource="{Binding Issues}" BorderThickness="0">
    <ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Path}"/><Run Text="："/><Run Text="{Binding Message}"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </GroupBox>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True"/>
   <Button Content="确认替换全部点位" IsEnabled="{Binding CanApply}" Click="Apply" Style="{StaticResource Primary}"/>
  </StackPanel>
 </Grid>
</Window>
