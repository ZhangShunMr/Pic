<UserControl x:Class="TrimContact.Desktop.Views.LayoutView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:TrimContact.Desktop.Controls">
<ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="230"/><RowDefinition Height="260"/></Grid.RowDefinitions>
<WrapPanel IsEnabled="{Binding CanEdit}">
<ComboBox ItemsSource="{Binding Variants}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedVariant}" Width="220"/>
<Button Content="新方案" Command="{Binding AddVariantCommand}"/><Button Content="复制方案" Command="{Binding CopyVariantCommand}"/><Button Content="删除方案" Command="{Binding DeleteVariantCommand}"/><StackPanel Width="240">
 <TextBlock Text="方案名称"/>
 <TextBox Text="{Binding SelectedVariant.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel></WrapPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
<controls:LayoutCanvas Workspace="{Binding}" Margin="0,0,12,10"/>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
<TextBlock Text="布置示意图：点击设置新增位置；点击已有符号选中点位。方形为卡扣，圆形为单边接触；坐标与刚度在下表编辑。" Style="{StaticResource Note}"/><WrapPanel><StackPanel Width="125">
 <TextBlock Text="新增X mm"/>
 <TextBox Text="{Binding PlacementX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel><StackPanel Width="125">
 <TextBlock Text="新增Y mm"/>
 <TextBox Text="{Binding PlacementY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel></WrapPanel><WrapPanel><Button Content="添加卡扣" Command="{Binding AddClipCommand}"/><Button Content="添加接触点" Command="{Binding AddContactCommand}"/></WrapPanel><StackPanel>
 <TextBlock Text="方案备注"/>
 <TextBox Text="{Binding SelectedVariant.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
</StackPanel></StackPanel></ScrollViewer></Grid>
<GroupBox Header="卡扣 · 双向线性弹簧" Grid.Row="2"><DockPanel IsEnabled="{Binding CanEdit}">
<WrapPanel DockPanel.Dock="Top"><Button Content="删除选中卡扣" Command="{Binding DeleteClipCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}" IsReadOnly="False" >
<DataGrid.Columns>
<DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="160"/>
<DataGridTextColumn Header="X mm" Binding="{Binding Xmm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="90"/>
<DataGridTextColumn Header="Y mm" Binding="{Binding Ymm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="90"/>
<DataGridTextColumn Header="法向刚度 N/mm" Binding="{Binding NormalStiffness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="145"/>
<DataGridTextColumn Header="切向刚度 N/mm" Binding="{Binding TangentialStiffness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="145"/>
<DataGridTextColumn Header="合力限值 N" Binding="{Binding ForceLimitN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="125"/>
</DataGrid.Columns>
</DataGrid></DockPanel></GroupBox>
<GroupBox Header="单边接触 · 预紧为几何等效压缩量，单位mm" Grid.Row="3"><DockPanel IsEnabled="{Binding CanEdit}">
<WrapPanel DockPanel.Dock="Top"><Button Content="删除选中接触点" Command="{Binding DeleteContactCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" IsReadOnly="False" >
<DataGrid.Columns>
<DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="150"/>
<DataGridTextColumn Header="X mm" Binding="{Binding Xmm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="80"/>
<DataGridTextColumn Header="Y mm" Binding="{Binding Ymm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="80"/>
<DataGridTextColumn Header="间隙 mm" Binding="{Binding GapMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="90"/>
<DataGridTextColumn Header="公差± mm" Binding="{Binding ToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="95"/>
<DataGridTextColumn Header="预紧 mm" Binding="{Binding PreloadMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="90"/>
<DataGridTextColumn Header="法向 N/mm" Binding="{Binding NormalStiffness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="110"/>
<DataGridTextColumn Header="切向 N/mm" Binding="{Binding TangentialStiffness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="110"/>
<DataGridTextColumn Header="摩擦 μ" Binding="{Binding Friction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="80"/>
<DataGridTextColumn Header="压缩限值 mm" Binding="{Binding CompressionLimitMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="110"/>
<DataGridTextColumn Header="材料/依据" Binding="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="200"/>
</DataGrid.Columns>
</DataGrid></DockPanel></GroupBox></Grid></ScrollViewer>
</UserControl>