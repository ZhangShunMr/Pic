<UserControl x:Class="TrimContact.Desktop.Views.ExchangeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:TrimContact.Desktop.Controls">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
<ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="Name" Width="300" HorizontalAlignment="Left"/><GroupBox Header="CSV布置交换 · UTF-8、英文逗号、英文小数点"><StackPanel><WrapPanel><Button Content="读取CSV文件" Command="{Binding ReadCsvCommand}"/><Button Content="导出模拟模板" Command="{Binding CsvTemplateCommand}"/><Button Content="导出当前布置" Command="{Binding ExportLayoutCommand}"/></WrapPanel><TextBlock Text="CSV只携带点位参数，不包含标定链。模板对应400×300mm轮廓。先建立目标方案和轮廓，再预检；任一行错误整批拒绝。" Style="{StaticResource Note}"/><TextBox Text="{Binding ImportCsvText, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" Height="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
<CheckBox Content="替换目标方案全部点位（未勾选为追加）" IsChecked="{Binding ImportReplace, NotifyOnSourceUpdated=True}"/>
<WrapPanel><Button Content="预检CSV" Command="{Binding PreviewImportCommand}"/><Button Content="应用预检结果" Command="{Binding ApplyImportCommand}"/></WrapPanel><ItemsControl ItemsSource="{Binding ImportMessages}"/></StackPanel></GroupBox><GroupBox Header="批量布置修改 · 预览后事务应用"><StackPanel><WrapPanel><StackPanel><TextBlock Text="范围"/><ComboBox ItemsSource="{Binding BatchTargets}" SelectedItem="{Binding BatchRequest.Target, NotifyOnSourceUpdated=True}" Width="160"/></StackPanel><StackPanel Width="150">
 <TextBlock Text="X平移 mm"/>
 <TextBox Text="{Binding BatchRequest.ShiftXmm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel><StackPanel Width="150">
 <TextBlock Text="Y平移 mm"/>
 <TextBox Text="{Binding BatchRequest.ShiftYmm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel><StackPanel Width="160">
 <TextBlock Text="法向刚度倍率"/>
 <TextBox Text="{Binding BatchRequest.NormalStiffnessFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel><StackPanel Width="160">
 <TextBlock Text="切向刚度倍率"/>
 <TextBox Text="{Binding BatchRequest.TangentialStiffnessFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel><StackPanel Width="150">
 <TextBlock Text="间隙增量 mm"/>
 <TextBox Text="{Binding BatchRequest.GapDeltaMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel><StackPanel Width="150">
 <TextBlock Text="预紧增量 mm"/>
 <TextBox Text="{Binding BatchRequest.PreloadDeltaMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
</StackPanel></WrapPanel><WrapPanel><Button Content="生成批量预览" Command="{Binding PreviewBatchCommand}"/><Button Content="应用批量预览" Command="{Binding ApplyBatchCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding BatchChanges}"  IsReadOnly="True" Height="220">
<DataGrid.Columns>
<DataGridTextColumn Header="点位" Binding="{Binding Point, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="180"/>
<DataGridTextColumn Header="字段" Binding="{Binding Field, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="160"/>
<DataGridTextColumn Header="单位" Binding="{Binding Unit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="90"/>
<DataGridTextColumn Header="修改前" Binding="{Binding Before, StringFormat=G6, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="140"/>
<DataGridTextColumn Header="修改后" Binding="{Binding After, StringFormat=G6, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="140"/>
</DataGrid.Columns>
</DataGrid><TextBlock Text="平移单次±1000mm，刚度倍率&gt;0且≤100，间隙与预紧增量±20mm；最终点位仍须在轮廓内，所有字段满足原范围。预览后修改输入或请求会阻止应用。" Style="{StaticResource Note}"/></StackPanel></GroupBox></StackPanel></ScrollViewer>
</UserControl>