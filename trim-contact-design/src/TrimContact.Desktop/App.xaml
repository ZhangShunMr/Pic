<Application x:Class="TrimContact.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#203B43"/>
  <SolidColorBrush x:Key="Accent" Color="#197C78"/>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#EEF2F2"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="0,3,7,3"/>
   <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="6,5"/>
   <Setter Property="Margin" Value="0,3,8,7"/>
   <Setter Property="MinWidth" Value="70"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="ToolTip">
    <Setter.Value><Binding RelativeSource="{RelativeSource Self}" Path="(Validation.Errors)[0].ErrorContent"/></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="6,4"/>
   <Setter Property="Margin" Value="0,3,8,7"/>
   <Setter Property="MinWidth" Value="100"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,12,8"/></Style>
  <Style TargetType="GroupBox">
   <Setter Property="Padding" Value="10"/>
   <Setter Property="Margin" Value="0,0,10,12"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CBD7D8"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="18"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,5,0,10"/>
  </Style>
  <Style x:Key="Note" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="#516D75"/>
   <Setter Property="Margin" Value="0,5,8,10"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/>
   <Setter Property="AlternatingRowBackground" Value="#F2F7F6"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="MinHeight" Value="120"/>
   <Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="Margin" Value="0,5,8,8"/>
   <Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="EnableRowVirtualization" Value="True"/>
   <Setter Property="EnableColumnVirtualization" Value="True"/>
  </Style>
 </Application.Resources>
</Application>
