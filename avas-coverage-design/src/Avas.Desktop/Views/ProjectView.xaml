<UserControl x:Class="Avas.Desktop.Views.ProjectView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Avas.Desktop">
    <StackPanel>
        <TextBlock Text="项目档案" Style="{StaticResource Heading}"/>
        <TextBlock Text="普通启动为空白。先填写项目档案，再逐项建立声源与观察点。示例包含模拟输入，会持续显示来源标记。" Style="{StaticResource Hint}"/>
        <WrapPanel>
            <Button Content="新建空白" Command="{Binding Commands[New]}"/>
            <Button Content="载入模拟示例" Command="{Binding Commands[Demo]}"/>
            <Button Content="导入项目文件…" Command="{Binding Commands[OpenFile]}"/>
        </WrapPanel>
        <TextBlock Text="项目名称（必填，最多100字符）"/>
        <TextBox x:Name="ProjectName" Text="{ui:Edit Draft.Name}"/>
        <TextBlock Text="负责人（最多100字符）"/>
        <TextBox Text="{ui:Edit Draft.Owner}"/>
        <TextBlock Text="车辆 / 设计对象（最多100字符）"/>
        <TextBox Text="{ui:Edit Draft.Vehicle}"/>
        <TextBlock Text="设计目的（最多2000字符）"/>
        <TextBox Text="{ui:Edit Draft.Purpose}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"/>
        <TextBlock Text="项目备注（最多4000字符）"/>
        <TextBox Text="{ui:Edit Draft.Note}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
        <WrapPanel>
            <Button Content="复制为独立项目" Command="{Binding Commands[CopyProject]}"/>
            <Button Content="切换归档状态" Command="{Binding Commands[Archive]}"/>
        </WrapPanel>
        <TextBlock Text="{Binding Project.Archived, StringFormat=归档只读：{0}}"/>
        <TextBlock Text="{Binding Project.Revision, StringFormat=修订号：{0}}"/>
        <GroupBox Header="本机项目库">
            <StackPanel>
                <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Hint}"/>
                <ComboBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedStored}" DisplayMemberPath="Name"/>
                <WrapPanel>
                    <Button Content="刷新列表" Command="{Binding Commands[RefreshLibrary]}"/>
                    <Button Content="打开所选" Command="{Binding Commands[OpenStored]}"/>
                    <Button Content="打开 .bak 备份" Command="{Binding Commands[OpenBackup]}"/>
                </WrapPanel>
                <TextBlock Text="重复保存保留上一版 .bak；检测外部修改冲突。备份打开后请复制为独立项目保存。导入外部项目后，保存仍写入本机项目库；搬迁请导出完整 .avasproj。" Style="{StaticResource Hint}"/>
                <Button Content="导出完整项目…" Command="{Binding Commands[Export]}" CommandParameter="project"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
