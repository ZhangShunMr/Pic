<Window x:Class="AcousticSeal.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AcousticSeal.Desktop"
 Title="{Binding Title}" Width="1480" Height="960" MinWidth="1180" MinHeight="720"
 Background="#F3F5F0" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources><local:EnumTextConverter x:Key="EnumText"/></Window.Resources>
 <Window.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
  <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
 </Window.InputBindings>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="White" Padding="8,4">
   <MenuItem Header="文件(_F)">
    <MenuItem Header="新建空白项目   Ctrl+N" Command="{Binding NewCommand}"/>
    <MenuItem Header="打开项目/备份   Ctrl+O" Command="{Binding OpenCommand}"/>
    <Separator/>
    <MenuItem Header="保存项目   Ctrl+S" Command="{Binding SaveCommand}"/>
    <MenuItem Header="另存为" Command="{Binding SaveAsCommand}"/>
    <MenuItem Header="复制为新项目" Command="{Binding CopyCommand}"/>
    <Separator/><MenuItem Header="载入独立模拟案例" Command="{Binding DemoCommand}"/>
    <MenuItem Header="归档/解除归档" Command="{Binding ArchiveCommand}"/>
   </MenuItem>
   <MenuItem Header="编辑(_E)">
    <MenuItem Header="撤销项目操作   Ctrl+Z" Command="{Binding UndoCommand}"/>
    <MenuItem Header="重做项目操作   Ctrl+Y" Command="{Binding RedoCommand}"/>
    <MenuItem Header="应用编辑" Command="{Binding ApplyCommand}"/>
   </MenuItem>
   <MenuItem Header="成果输出(_R)">
    <MenuItem Header="导出完整HTML报告" Command="{Binding ReportCommand}"/>
    <MenuItem Header="导出结果CSV" Command="{Binding ResultsCommand}"/>
    <MenuItem Header="导出原始频带CSV（含试验GUID）" Command="{Binding MeasurementsCommand}"/>
    <MenuItem Header="导出分析JSON" Command="{Binding JsonCommand}"/>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Bottom" Background="#E4EDE6" Padding="12,8">
   <StackPanel><TextBlock Text="{Binding Status}" Foreground="#173E3D"/><TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#536963"/></StackPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="218"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#153C3B" Padding="16,22">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
      <TextBlock Text="SEAL / LAB" Foreground="#D9B391" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="封堵试验分析" Foreground="White" FontSize="18" Margin="0,10,0,5"/>
      <TextBlock Text="Windows 原生工作台  V3.0" Foreground="#B4CDC5" FontSize="11"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
      <TextBlock Text="{Binding ProjectSummary}" Foreground="#C3D7CF"/>
      <TextBlock Text="20 步会话撤销 · 文件内嵌频带" Foreground="#91B2A8" FontSize="11" Margin="0,10,0,0"/>
     </StackPanel>
     <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Hint}" FontSize="10" Opacity="0.75" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="#E8EEE7" Padding="16,24" BorderBrush="#D3DDD3" BorderThickness="1,0,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="试验检查" Foreground="#173E3D" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Inspector}" Margin="0,20,0,20" LineHeight="23"/>
      <Border Background="#FAEEE1" Padding="12"><StackPanel><TextBlock Text="数据来源" FontWeight="SemiBold" Foreground="#805031"/><TextBlock Text="{Binding SourceSummary}" Margin="0,8,0,0"/></StackPanel></Border>
      <TextBlock Text="工作提示" FontWeight="SemiBold" Margin="0,24,0,10"/>
      <TextBlock Text="编辑后先应用，再保存项目。切换页面或关闭窗口时会检查未应用草稿。红色错误提示会指出字段或行号，修复后重新应用。" LineHeight="22"/>
      <TextBlock Text="导入先建立试验，再导出原始频带CSV取得GUID。缺失声级留空，禁止补零。" Margin="0,20,0,0" LineHeight="22"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <DockPanel Grid.Column="1" Margin="22,20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold" Foreground="#153C3B"/><TextBlock Text="{Binding PageHint}" Foreground="#60746B" Margin="0,6,0,0"/></StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel Grid.Column="0" Width="200" Margin="0,0,16,0" Visibility="{Binding IsList, Converter={StaticResource Visible}}">
      <WrapPanel DockPanel.Dock="Top"><Button Content="新增" Command="{Binding AddCommand}"/><Button Content="删除" Command="{Binding DeleteCommand}"/><Button Content="复制试验结构" Command="{Binding DuplicateTrialCommand}" Visibility="{Binding IsTrial, Converter={StaticResource Visible}}"/></WrapPanel>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#CCDAD2">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="#66786D" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
     <Grid Grid.Column="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasEditor, Converter={StaticResource Visible}}">
       <StackPanel>
        <WrapPanel><Button Content="应用编辑" Command="{Binding ApplyCommand}" Background="#1E6967" Foreground="White"/><Button Content="放弃编辑" Command="{Binding RevertCommand}"/><Button Content="保存项目" Command="{Binding SaveCommand}"/></WrapPanel>
        <TextBlock Text="{Binding Editor.Identity}" Foreground="#687D72" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding Editor.Fields}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Width="300" Margin="0,0,18,14">
           <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#244A40"/>
           <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" AcceptsReturn="True" MaxHeight="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
           <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsChoice, Converter={StaticResource Visible}}"/>
           <CheckBox IsChecked="{Binding Flag}" Content="启用 / 确认" Margin="0,8,0,6" Visibility="{Binding IsFlag, Converter={StaticResource Visible}}"/>
           <TextBlock Text="{Binding Help}" FontSize="10" Foreground="#657B6D"/>
          </StackPanel>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Visibility="{Binding Editor.HasBands, Converter={StaticResource Visible}}">
         <GroupBox Header="本次封堵位置（单项选1个，组合至少2个，基线不选）">
          <ItemsControl ItemsSource="{Binding Editor.Locations}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </GroupBox>
         <TextBlock Text="频带工作表 · Hz / dB re 20 µPa · 空白声级为缺失" FontWeight="SemiBold" Margin="0,8"/>
         <WrapPanel><Button Content="增加频带行" Command="{Binding AddBandCommand}"/><Button Content="移除选中行" Command="{Binding RemoveBandCommand}"/></WrapPanel>
         <DataGrid ItemsSource="{Binding Editor.Bands}" SelectedItem="{Binding SelectedBand}" Height="260">
          <DataGrid.Columns><DataGridTextColumn Header="频率 Hz" Binding="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="声级 dB" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="备注" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
         </DataGrid>
         <Expander Header="粘贴两列频带（Hz,声级，无表头；替换当前草稿频带）" Margin="0,14">
          <StackPanel><TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><Button Content="放入频带草稿" Command="{Binding PasteCommand}" HorizontalAlignment="Left"/></StackPanel>
         </Expander>
        </StackPanel>
        <TextBlock Text="参数修改只改变判读规则，不改变原始测量。应用操作始终重新计算全部历史输入；需保存后才能恢复本次修改。" Foreground="#6D7663" Margin="0,16"/>
       </StackPanel>
      </ScrollViewer>
      <DockPanel Visibility="{Binding IsImport, Converter={StaticResource Visible}}">
       <StackPanel DockPanel.Dock="Top">
        <WrapPanel><Button Content="读取CSV文件" Command="{Binding ImportFileCommand}"/><Button Content="预检当前内容" Command="{Binding PreviewCommand}"/><Button Content="整体应用导入" Command="{Binding ImportCommand}"/></WrapPanel>
        <WrapPanel><TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox SelectedValue="{Binding ImportMode}" SelectedValuePath="Tag" Width="180"><ComboBoxItem Content="合并（覆盖同频）" Tag="{x:Static local:ImportModes.Merge}"/><ComboBoxItem Content="替换（涉及试验）" Tag="{x:Static local:ImportModes.Replace}"/></ComboBox><TextBlock Text="分隔符" Margin="14,0,8,0" VerticalAlignment="Center"/><ComboBox SelectedValue="{Binding Delimiter}" SelectedValuePath="Tag" Width="100"><ComboBoxItem Content="逗号" Tag=","/><ComboBoxItem Content="分号" Tag=";"/><ComboBoxItem Content="制表符" Tag="tab"/></ComboBox></WrapPanel>
        <TextBlock Text="先建立试验并导出原始频带CSV取得GUID；固定表头trial_id,frequency_hz,level_db。缺失值可留空/NA/N/A/null；错误时整批不应用。" Margin="0,10"/>
        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="250" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
       </StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding ImportStatus}" Margin="0,14"/></ScrollViewer>
      </DockPanel>
      <ScrollViewer Visibility="{Binding IsResult, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" DisplayMemberPath="Title"/>
        <TextBlock Text="{Binding ResultNote}" Margin="0,10" Foreground="#6B4F35"/>
        <WrapPanel><TextBlock Text="显示范围 Hz" VerticalAlignment="Center"/><TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" Width="85" Margin="8,0"/><TextBlock Text="—" VerticalAlignment="Center"/><TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" Width="85" Margin="8,0"/><Button Content="筛选显示" Command="{Binding FilterCommand}"/><Button Content="导出选中配对原始核对表" Command="{Binding WorkbookCommand}"/></WrapPanel>
        <CheckBox x:Name="OriginalCheck" Content="显示基线和目标原始频谱" Margin="0,8"/>
        <local:SpectrumPlot Items="{Binding ResultBands}" Original="{Binding IsChecked, ElementName=OriginalCheck}" Height="290"/>
        <DataGrid ItemsSource="{Binding ResultBands}" IsReadOnly="True" Height="300" Margin="0,14">
         <DataGrid.Columns><DataGridTextColumn Header="Hz" Binding="{Binding Frequency}" Width="80"/><DataGridTextColumn Header="基线 dB" Binding="{Binding Baseline, TargetNullValue=缺失, StringFormat=F3}" Width="90"/><DataGridTextColumn Header="目标 dB" Binding="{Binding Target, TargetNullValue=缺失, StringFormat=F3}" Width="90"/><DataGridTextColumn Header="ΔL dB" Binding="{Binding Difference, TargetNullValue=无结果, StringFormat=F3}" Width="90"/><DataGridTextColumn Header="说明" Binding="{Binding Interpretation}" Width="*"/></DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="正差表示目标声级低于基线；单项分贝不能相加预测组合。共用基线配对不会生成独立样本区间。完整统计请导出报告核对。"/>
       </StackPanel>
      </ScrollViewer>
      <DockPanel Visibility="{Binding IsQuality, Converter={StaticResource Visible}}">
       <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
        <Expander Header="工程规则情景（不更改测量数据）">
         <StackPanel><ComboBox ItemsSource="{Binding ScenarioParameters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding ScenarioKey}"/><TextBox Text="{Binding ScenarioValues, UpdateSourceTrigger=PropertyChanged}"/><Button Content="比较并导出情景" Command="{Binding ScenarioCommand}"/><TextBlock Text="{Binding AuxiliaryResult}" MaxHeight="160"/></StackPanel>
        </Expander>
        <Button Content="与另一项目文件核对输入版本" Command="{Binding RevisionCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
       </StackPanel>
       <DataGrid ItemsSource="{Binding Quality}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="检查项" Binding="{Binding Title}" Width="160"/><DataGridTextColumn Header="依据" Binding="{Binding Reason}" Width="240"/><DataGridTextColumn Header="处理建议" Binding="{Binding Repair}" Width="240"/></DataGrid.Columns></DataGrid>
      </DockPanel>
      <ScrollViewer Visibility="{Binding IsAudit, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="记录分析复核快照" FontWeight="SemiBold"/>
        <TextBlock Text="复核人（必填）" Margin="0,12,0,0"/><TextBox Text="{Binding Reviewer, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="复核说明"/><TextBox Text="{Binding ReviewComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"/>
        <Button Content="记录复核" Command="{Binding ReviewCommand}" HorizontalAlignment="Left"/>
        <TextBlock Text="累计复核" Margin="0,12" FontWeight="SemiBold"/>
        <DataGrid ItemsSource="{Binding Reviews}" IsReadOnly="True" Height="180"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="170"/><DataGridTextColumn Header="复核人" Binding="{Binding Reviewer}" Width="100"/><DataGridTextColumn Header="输入修订" Binding="{Binding InputRevision}" Width="80"/><DataGridTextColumn Header="说明" Binding="{Binding Comment}" Width="240"/><DataGridTextColumn Header="输入SHA-256" Binding="{Binding InputHash}" Width="400"/></DataGrid.Columns></DataGrid>
        <TextBlock Text="累计操作审计" Margin="0,18,0,10" FontWeight="SemiBold"/>
        <DataGrid ItemsSource="{Binding Audit}" IsReadOnly="True" Height="300"><DataGrid.Columns><DataGridTextColumn Header="修订" Binding="{Binding Revision}" Width="60"/><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="180"/><DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="200"/><DataGridTextColumn Header="变更" Binding="{Binding Detail}" Width="300"/></DataGrid.Columns></DataGrid>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
