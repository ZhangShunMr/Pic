<Application x:Class="AcousticSeal.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="Background" Value="#F1F5F3"/><Setter Property="Foreground" Value="#173E3D"/>
   <Setter Property="BorderBrush" Value="#B3C6C1"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,3"/>
   <Setter Property="BorderBrush" Value="#B3C6C1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E0E8E4"/><Setter Property="RowBackground" Value="White"/>
   <Setter Property="AlternatingRowBackground" Value="#F4F7F5"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="BorderBrush" Value="#D0DDD7"/><Setter Property="MinRowHeight" Value="34"/>
   <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
  </Style>
  <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#CEDBD6"/></Style>
 </Application.Resources>
</Application>
