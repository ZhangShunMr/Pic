@inherits VmComponent
<section class="panel">
    <h2>比较规则与工程筛查参数</h2>
    <div class="notice">默认值是产品工程初值，没有标准或真实测量标定依据。相等边界允许；修改后所有历史输入重新计算。@Software.ScreeningNote</div>
    <form @onsubmit="Vm.SaveSettings" @onsubmit:preventDefault novalidate>
        <fieldset disabled="@Vm.Archived">
            <div class="form-grid three">
                @foreach (var input in Vm.Settings.Inputs)
                {
                    <label class="field">
                        <span>@input.Label @input.Unit</span>
                        <input name="setting-@input.Key" @bind="input.Value" @bind:event="oninput" @bind:after="Vm.Settings.MarkDirty" inputmode="decimal" />
                        <small>初值 @input.Default；允许 @input.Minimum—@input.Maximum @input.Unit</small>
                    </label>
                }
            </div>
            <div class="target-checks">
                <label class="check"><input name="require-sample-rate" type="checkbox" @bind="Vm.Settings.RequireSampleRateMatch" @bind:after="Vm.Settings.MarkDirty" />比较时要求两侧采样率已填写且相同</label>
                <label class="check"><input name="require-sync" type="checkbox" @bind="Vm.Settings.RequireSynchronizationMatch" @bind:after="Vm.Settings.MarkDirty" />比较时要求时钟与同步定义已填写且相同</label>
            </div>
            <div class="editor-actions"><button class="primary" type="submit" data-testid="apply-settings">应用参数并重算</button><button type="button" @onclick="Vm.Settings.ResetDefaults">将草稿重置为工程初值</button></div>
        </fieldset>
    </form>
</section>
<section class="panel">
    <h2>重复性：同重复组、类型、位置集合与来源</h2>
    <p class="muted">每频带分别统计。样本SD是dB数值离散度，n&lt;2不生成SD或判定；工况不一致禁止汇总。缺失数量包括该组中未提供该频带的记录。</p>
    @if (Vm.Analysis.Repeatability.Count == 0)
    {
        <div class="empty">尚无重复组。在试验档案填写重复组名称后应用。</div>
    }
    @foreach (var group in Vm.Analysis.Repeatability)
    {
        <h3>@group.Name · @group.Kind.Text() · @group.Source.Text()</h3>
        @if (group.BlockingReasons.Count > 0)
        {
            <div class="error-list">@string.Join("；", group.BlockingReasons)</div>
        }
        <div class="table-wrap">
            <table>
                <thead><tr><th>Hz</th><th>n</th><th>缺失</th><th>算术均值 dB</th><th>能量均值 dB</th><th>样本SD dB</th><th>极差 dB</th><th>状态</th></tr></thead>
                <tbody>
                    @foreach (var band in group.Bands)
                    {
                        <tr>
                            <td>@band.Frequency</td><td>@band.Statistics.Count</td><td>@band.MissingCount</td>
                            <td>@Software.Format(band.Statistics.ArithmeticMean)</td><td>@Software.Format(band.Statistics.EnergyMean)</td>
                            <td>@Software.Format(band.Statistics.StandardDeviation)</td><td>@Software.Format(band.Statistics.Range)</td>
                            <td><StatusBadge Status="band.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<section class="panel">
    <h2>基线漂移与解除封堵恢复</h2>
    <p class="muted">仅使用显式对应的基线、结束基线和恢复试验。阈值内不保证物理状态完全恢复；未设置配对或无共同有效频带时不能判断。</p>
    <div class="table-wrap">
        <table data-testid="screening-table">
            <thead><tr><th>配对</th><th>用途</th><th>最大绝对差 dB</th><th>最差频率 Hz</th><th>用户阈值 dB</th><th>状态</th></tr></thead>
            <tbody>
                @foreach (var pair in Vm.Analysis.Pairs.Where(pair => pair.Screening is not null))
                {
                    var screening = pair.Screening!;
                    <tr><td>@pair.Title</td><td>@pair.Purpose.Text()</td><td>@Software.Format(screening.MaximumAbsoluteDifference)</td><td>@Software.Format(screening.WorstFrequency)</td><td>@Software.Format(screening.Threshold)</td><td><StatusBadge Status="screening.Status" /></td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
<section class="panel">
    <div class="section-heading">
        <div><h2>数据质量问题与修复入口</h2><p class="muted">点击定位回到对应对象，按真实记录修正；未提供的数据不能凭猜测补齐。</p></div>
        <label class="field"><span>问题级别</span><select name="quality-filter" @bind="Vm.QualitySeverity"><option value="all">全部</option>@foreach (var severity in Enum.GetValues<IssueSeverity>()) { <option value="@severity">@severity.Text()</option> }</select></label>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>级别</th><th>对象</th><th>问题</th><th>具体处理建议</th><th>定位</th></tr></thead>
            <tbody>
                @foreach (var issue in Vm.VisibleIssues())
                {
                    <tr><td>@issue.Severity.Text()</td><td>@issue.Title</td><td>@issue.Reason</td><td>@issue.Repair</td><td><button @onclick="() => Vm.NavigateIssue(issue)">定位对象</button></td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
<section class="panel">
    <h2>试验覆盖与时间线</h2>
    <p class="muted">@Vm.Analysis.Coverage.Note</p>
    <div class="metric-grid compact">
        @foreach (var item in Vm.Analysis.Coverage.TrialTypes)
        {
            <article><span>@item.Key.Text()</span><strong>@item.Value</strong></article>
        }
    </div>
    <h3>工况完整性</h3>
    <div class="table-wrap">
        <table>
            <thead><tr><th>工况</th><th>关联试验数</th><th>缺失口径</th></tr></thead>
            <tbody>
                @foreach (var item in Vm.Analysis.Coverage.Conditions)
                {
                    <tr><td>@item.Name</td><td>@item.TrialCount</td><td>@(item.Missing.Count == 0 ? "必要字段齐全，仍需复核实际记录" : string.Join("；", item.Missing))</td></tr>
                }
            </tbody>
        </table>
    </div>
    <h3>位置覆盖</h3>
    <div class="table-wrap">
        <table>
            <thead><tr><th>位置</th><th>单项试验数</th><th>组合试验数</th><th>可比较封堵配对数</th></tr></thead>
            <tbody>@foreach (var item in Vm.Analysis.Coverage.Locations) { <tr><td>@item.Name</td><td>@item.SingleCount</td><td>@item.CombinationCount</td><td>@item.ValidPairCount</td></tr> }</tbody>
        </table>
    </div>
    <h3>频带完整性</h3>
    <p class="muted">明确缺失：频率键存在而声级为空；未声明：试验没有该频率，两者都不补零。</p>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Hz</th><th>有效记录</th><th>明确缺失</th><th>未声明</th></tr></thead>
            <tbody>@foreach (var item in Vm.Analysis.Coverage.Frequencies) { <tr><td>@item.Frequency</td><td>@item.Valid</td><td>@item.Missing</td><td>@item.Undeclared</td></tr> }</tbody>
        </table>
    </div>
    <h3>按带时区时间排序</h3>
    <div class="table-wrap">
        <table>
            <thead><tr><th>时间</th><th>试验</th><th>类型</th><th>来源</th><th>有效频带</th><th>作为目标的配对数</th></tr></thead>
            <tbody>@foreach (var item in Vm.Analysis.Coverage.Timeline) { <tr><td>@Software.Time(item.Time)</td><td>@item.Name</td><td>@item.Kind.Text()</td><td>@item.Source.Text()</td><td>@item.ValidBands</td><td>@item.TargetPairs</td></tr> }</tbody>
        </table>
    </div>
</section>

<InputWorkbookPanel />

<ScenarioPanel />
